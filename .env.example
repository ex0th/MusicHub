# MusicHub – Konfiguration. Kopieren nach .env und anpassen. .env NIE committen.
# Alle Backend-Variablen haben das Präfix MUSICHUB_.

# --- Allgemein -------------------------------------------------------------------
# development | test | production   (Images setzen production als Standard)
MUSICHUB_APP_ENV=production
MUSICHUB_LOG_LEVEL=INFO
# text | json
MUSICHUB_LOG_FORMAT=json

# Image-Version für compose.yaml: latest oder ein Release-Tag wie v0.1.0
MUSICHUB_VERSION=latest

# Veröffentlichter Port des Frontends (enthält /api als Reverse Proxy).
# 127.0.0.1 = nur lokal/Reverse Proxy auf demselben Host, 0.0.0.0 = im Netz erreichbar.
MUSICHUB_HTTP_BIND=127.0.0.1
MUSICHUB_HTTP_PORT=8080

# --- Datenbank -------------------------------------------------------------------
POSTGRES_USER=musichub
# Langes Zufallspasswort, nur Buchstaben und Ziffern (wird in eine URL eingesetzt):
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=musichub

# --- Authentifizierung -------------------------------------------------------------
# dev  = statisches Token (nur development/test, in production verweigert der Start)
# oidc = Access-Tokens eines OIDC-Providers (Authentik) prüfen
MUSICHUB_AUTH_MODE=oidc

# Für dev: mindestens 16 Zeichen, z. B. openssl rand -hex 24
MUSICHUB_DEV_AUTH_TOKEN=
MUSICHUB_DEV_AUTH_USER=dev

# Für oidc (Authentik: Provider -> OpenID Configuration Issuer, z. B.
# https://auth.example.com/application/o/musichub/)
MUSICHUB_OIDC_ISSUER=
# Client-ID der Anwendung in Authentik (steht im "aud"-Claim)
MUSICHUB_OIDC_AUDIENCE=
# Optional, sonst per Discovery: https://auth.example.com/application/o/musichub/jwks/
MUSICHUB_OIDC_JWKS_URL=
# Nur Mitglieder dieser Gruppe dürfen schreiben (leer = alle angemeldeten Nutzer)
MUSICHUB_OIDC_WRITE_GROUP=musichub-admins
MUSICHUB_OIDC_GROUPS_CLAIM=groups

# Nur nötig, wenn Frontend und API auf verschiedenen Origins laufen (JSON-Liste)
# MUSICHUB_CORS_ORIGINS=["https://music.example.com"]

# --- Plattform-Connectoren (leer = Connector deaktiviert) ----------------------------
MUSICHUB_SPOTIFY_CLIENT_ID=
MUSICHUB_SPOTIFY_CLIENT_SECRET=
MUSICHUB_SOUNDCLOUD_CLIENT_ID=
MUSICHUB_SOUNDCLOUD_CLIENT_SECRET=
MUSICHUB_YOUTUBE_API_KEY=

# --- Import ----------------------------------------------------------------------
# Größte erlaubte Importdatei in Byte (Standard 10 MB). Über 12 MB auch
# client_max_body_size in frontend/nginx/default.conf anheben.
MUSICHUB_IMPORT_MAX_BYTES=10485760
# Höchstzahl Datensätze pro Importdatei
MUSICHUB_IMPORT_MAX_ROWS=20000

# --- Hintergrundjobs -------------------------------------------------------------
MUSICHUB_WORKER_POLL_INTERVAL_SECONDS=2
