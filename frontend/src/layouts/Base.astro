---
import "../styles/global.css";

export type Section = "dashboard" | "library" | "playlists" | "matching" | "platforms" | "settings";

interface Props {
  title: string;
  section: Section;
}
const { title, section } = Astro.props;

const nav: { id: Section; href: string; label: string; icon: string }[] = [
  { id: "dashboard", href: "/", label: "Dashboard", icon: "M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z" },
  {
    id: "library",
    href: "/library/",
    label: "Musikbibliothek",
    icon: "M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zM12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z",
  },
  { id: "playlists", href: "/playlists/", label: "Playlists", icon: "M4 6h12M4 11h12M4 16h7M17 14v6M14 17h6" },
  {
    id: "matching",
    href: "/matching/",
    label: "Matching",
    icon: "M6 3v5a5 5 0 0 0 5 5h8M16 10l3 3-3 3M6 21v-5",
  },
  { id: "platforms", href: "/platforms/", label: "Plattformen", icon: "M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4" },
  {
    id: "settings",
    href: "/settings/",
    label: "Einstellungen",
    icon: "M4 7h10M18 7h2M4 17h4M12 17h8M16 5v4M10 15v4",
  },
];
---

<!doctype html>
<html lang="de" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#17181c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme.js"></script>
    <title>{title} – MusicHub</title>
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt</a>
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="MusicHub, zum Dashboard">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <rect x="2" y="9" width="5" height="6" rx="1" fill="currentColor"></rect>
          <rect x="9.5" y="9" width="5" height="6" rx="1" fill="var(--accent)"></rect>
          <rect x="17" y="9" width="5" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
        </svg>
        <span>MusicHub</span>
      </a>
      <nav aria-label="Hauptnavigation">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item.id === section ? "page" : undefined}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d={item.icon} />
              </svg>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="session" id="session-indicator" data-state="anonymous">Nicht angemeldet</div>
    </aside>

    <main id="main">
      <slot />
    </main>

    <div id="toasts" class="toasts" aria-live="polite"></div>

    <script>
      import { createSession } from "../lib/session";
      const indicator = document.getElementById("session-indicator");
      const { api, tokens } = createSession();
      if (indicator && tokens.getToken()) {
        api
          .me()
          .then((me) => {
            indicator.textContent = me.can_write ? me.display_name : `${me.display_name} (nur lesen)`;
            indicator.dataset["state"] = "authenticated";
          })
          .catch(() => {
            indicator.textContent = "Token ungültig";
            indicator.dataset["state"] = "error";
          });
      }
    </script>
  </body>
</html>
