---
interface Props {
  title: string;
  active: "overview" | "library";
}
const { title, active } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · MusicHub</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <svg viewBox="0 0 32 32" aria-hidden="true" width="26" height="26">
          <circle cx="16" cy="16" r="15" fill="currentColor"></circle>
          <circle cx="16" cy="16" r="10" fill="none" stroke="var(--bg)" stroke-opacity=".35"></circle>
          <circle cx="16" cy="16" r="6.5" fill="none" stroke="var(--bg)" stroke-opacity=".35"></circle>
          <circle cx="16" cy="16" r="3.2" fill="var(--accent)"></circle>
        </svg>
        <span>MusicHub</span>
      </a>
      <nav aria-label="Hauptnavigation">
        <a href="/" aria-current={active === "overview" ? "page" : undefined}>Übersicht</a>
        <a href="/library/" aria-current={active === "library" ? "page" : undefined}>Sammlung</a>
      </nav>
      <div class="session" id="session-indicator" data-state="anonymous">nicht angemeldet</div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>Lokale Sammlung ist die führende Instanz.</span>
      <a href="/api/docs">API-Dokumentation</a>
    </footer>

    <script>
      import { createSession } from "../lib/session";
      const indicator = document.getElementById("session-indicator");
      const { api, tokens } = createSession();
      if (indicator && tokens.getToken()) {
        api
          .me()
          .then((me) => {
            indicator.textContent = `${me.display_name}${me.can_write ? "" : " (nur lesen)"}`;
            indicator.dataset["state"] = "authenticated";
          })
          .catch(() => {
            indicator.textContent = "Token ungültig";
            indicator.dataset["state"] = "error";
          });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f3ee;
    --surface: #fffdf9;
    --ink: #1d1b19;
    --muted: #6d665e;
    --line: #e2dbd1;
    --accent: #d2491f;
    --ok: #2f7a4b;
    --warn: #b7791f;
    --err: #b3261e;
    --radius: 10px;
    --mono: ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", Menlo, monospace;
    --sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151413;
      --surface: #1d1c1a;
      --ink: #ece7df;
      --muted: #a0978c;
      --line: #2f2c29;
      --accent: #ff7a45;
      --ok: #5cc28a;
      --warn: #e2b04a;
      --err: #ff7b72;
    }
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.5;
  }
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  a {
    color: inherit;
  }
  main {
    flex: 1;
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding: 28px 16px 48px;
  }
  h1 {
    font-size: 1.9rem;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }
  h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 32px 0 12px;
    font-weight: 600;
  }
  .lede {
    color: var(--muted);
    margin: 0 0 8px;
    max-width: 60ch;
  }
  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
  }
  .mono {
    font-family: var(--mono);
    font-size: 0.85em;
  }
  input,
  button {
    font: inherit;
    color: inherit;
  }
  input {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px 10px;
    min-width: 0;
  }
  input:focus-visible,
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  button {
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--bg);
    border-radius: 8px;
    padding: 8px 14px;
    cursor: pointer;
    font-weight: 500;
  }
  button.ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--line);
  }
  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
    margin-right: 6px;
    vertical-align: 1px;
  }
  .dot[data-state="ok"],
  .dot[data-state="ready"] {
    background: var(--ok);
  }
  .dot[data-state="degraded"],
  .dot[data-state="not_configured"] {
    background: var(--warn);
  }
  .dot[data-state="error"],
  .dot[data-state="suspended"] {
    background: var(--err);
  }
  .error-text {
    color: var(--err);
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    font-size: 1.05rem;
  }
  .topbar nav {
    display: flex;
    gap: 4px;
  }
  .topbar nav a {
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--muted);
  }
  .topbar nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--bg);
  }
  .session {
    margin-left: auto;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .session[data-state="authenticated"] {
    color: var(--ink);
  }
  .session[data-state="error"] {
    color: var(--err);
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 16px;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>
