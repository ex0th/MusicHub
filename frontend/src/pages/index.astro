---
import Base from "../layouts/Base.astro";
---

<Base title="Dashboard" section="dashboard">
  <div id="content">
    <div class="page-head">
      <div>
        <h1 id="headline">Dashboard</h1>
        <p class="lede" id="summary">Lade Bibliothek …</p>
      </div>
      <a class="button" href="/library/?new=1">Track hinzufügen</a>
    </div>

    <section aria-labelledby="coverage-title">
      <h2 id="coverage-title">Verfügbarkeit nach Plattform</h2>
      <div class="panel coverage-board" id="coverage-board"></div>
    </section>

    <section aria-labelledby="single-title">
      <div class="section-head">
        <h2 id="single-title">Nur auf einer Plattform verfügbar</h2>
        <a id="single-all" class="muted" href="/library/?count=1" hidden>Alle anzeigen</a>
      </div>
      <p class="muted section-note">
        Fällt diese eine Plattform weg, ist der Track nur noch lokal verzeichnet.
      </p>
      <div id="single-list"></div>
    </section>
  </div>
</Base>

<script>
  import { formatDuration } from "../lib/api";
  import { PLATFORMS } from "../lib/platforms";
  import { createSession, requireLogin } from "../lib/session";
  import type { LibraryStats, Track } from "../lib/types";
  import { $, coverageStrip, errorMessage, h, plural } from "../lib/ui";

  const { api, tokens } = createSession();
  const content = $("#content");

  function row(
    label: string,
    count: number,
    total: number,
    href: string,
    detail: (HTMLElement | string)[],
    exclusive = 0,
  ) {
    const pct = total ? (count / total) * 100 : 0;
    const exPct = total ? (exclusive / total) * 100 : 0;
    return h(
      "a",
      { class: "cov-row", href },
      h("span", { class: "cov-label" }, label),
      h(
        "span",
        { class: "cov-bar", "aria-hidden": "true" },
        h("span", { class: "cov-fill", style: `width:${pct}%` }),
        exclusive ? h("span", { class: "cov-excl", style: `width:${exPct}%` }) : null,
      ),
      h("span", { class: "cov-count num" }, count.toLocaleString("de-DE")),
      h("span", { class: "cov-detail" }, ...detail),
    );
  }

  function renderStats(stats: LibraryStats) {
    $("#headline").textContent =
      stats.tracks === 0 ? "Noch keine Tracks" : plural(stats.tracks, "Track", "Tracks");
    $("#summary").textContent =
      stats.tracks === 0
        ? "Lege deinen ersten Track an. Plattform-Links kannst du jederzeit ergänzen."
        : `In ${plural(stats.playlists, "Playlist", "Playlists")} organisiert, ${plural(
            stats.tags,
            "Tag",
            "Tags",
          )} vergeben. ${stats.local_only.toLocaleString("de-DE")} davon sind auf keiner Plattform verfügbar.`;

    const board = $("#coverage-board");
    board.replaceChildren(
      ...PLATFORMS.map((p) => {
        const s = stats.platforms.find((x) => x.platform === p.id);
        const detail: (HTMLElement | string)[] = [];
        if (s?.exclusive) detail.push(h("span", { class: "excl-note" }, `${s.exclusive} nur hier`));
        if (s?.unavailable) detail.push(h("span", { class: "gone-note" }, `${s.unavailable} nicht mehr verfügbar`));
        return row(
          p.label,
          s?.tracks ?? 0,
          stats.tracks,
          `/library/?platform=${p.id}`,
          detail,
          s?.exclusive ?? 0,
        );
      }),
      row("Nur lokal", stats.local_only, stats.tracks, "/library/?count=0", []),
    );
    if (stats.single_platform > 0) {
      const link = $<HTMLAnchorElement>("#single-all");
      link.hidden = false;
      link.textContent = `Alle ${stats.single_platform.toLocaleString("de-DE")} anzeigen`;
    }
  }

  function renderSingle(tracks: Track[]) {
    const list = $("#single-list");
    if (!tracks.length) {
      list.replaceChildren(h("p", { class: "empty panel" }, "Kein Track hängt an nur einer Plattform."));
      return;
    }
    const body = h("tbody");
    for (const t of tracks) {
      body.append(
        h(
          "tr",
          {},
          h(
            "td",
            { class: "t-title" },
            h("a", { href: `/track/?id=${t.id}` }, t.title),
            h("span", { class: "t-sub" }, t.artist),
          ),
          h("td", { class: "hide-sm" }, t.artist),
          h("td", { class: "hide-sm version" }, t.version ?? ""),
          h("td", { class: "right num hide-sm" }, formatDuration(t.duration_ms)),
          h("td", { class: "right" }, coverageStrip(t)),
        ),
      );
    }
    list.replaceChildren(h("div", { class: "table-wrap" }, h("table", { class: "data" }, body)));
  }

  async function load() {
    if (!requireLogin(tokens, content)) return;
    try {
      const [stats, single] = await Promise.all([
        api.stats(),
        api.listTracks({ platform_count: 1, sort: "updated_at", order: "desc", limit: 8 }),
      ]);
      renderStats(stats);
      renderSingle(single.items);
    } catch (e) {
      content.replaceChildren(h("div", { class: "notice" }, h("p", {}, errorMessage(e))));
    }
  }

  load();
</script>

<style is:global>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .section-note {
    margin-top: -6px;
    font-size: 0.9rem;
  }
  .coverage-board {
    display: flex;
    flex-direction: column;
    padding: 6px 0;
  }
  .cov-row {
    display: grid;
    grid-template-columns: 120px 1fr 64px minmax(0, 220px);
    align-items: center;
    gap: 16px;
    padding: 12px 20px;
    text-decoration: none;
  }
  .cov-row:hover {
    background: var(--raised);
  }
  .cov-row + .cov-row {
    border-top: 1px solid var(--line);
  }
  .cov-row:last-child .cov-label {
    color: var(--muted);
  }
  .cov-label {
    font-weight: 560;
  }
  .cov-bar {
    position: relative;
    height: 8px;
    border-radius: 4px;
    background: var(--raised);
    overflow: hidden;
  }
  .cov-fill,
  .cov-excl {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 4px;
  }
  .cov-fill {
    background: var(--ink);
    opacity: 0.8;
  }
  .cov-excl {
    background: var(--accent);
  }
  .cov-count {
    text-align: right;
    font-weight: 600;
  }
  .cov-detail {
    display: flex;
    gap: 12px;
    font-size: 0.84rem;
    color: var(--muted);
  }
  .excl-note::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 2px;
    background: var(--accent);
  }
  .gone-note {
    color: var(--danger);
  }
  @media (max-width: 720px) {
    .cov-row {
      grid-template-columns: 1fr auto;
      gap: 6px 12px;
      padding: 12px 16px;
    }
    .cov-bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .cov-detail {
      grid-column: 1 / -1;
    }
    .cov-detail:empty {
      display: none;
    }
  }
</style>
