---
import Base from "../layouts/Base.astro";
---

<Base title="Sammlung" active="library">
  <h1>Sammlung</h1>
  <p class="lede">
    Alle Tracks der lokalen Datenbank – unabhängig davon, ob und wo sie auf Streamingplattformen
    verfügbar sind.
  </p>

  <div class="toolbar">
    <label class="visually-hidden" for="search">Suche</label>
    <input id="search" type="search" placeholder="Titel, Interpret oder Album suchen" />
    <span class="count" id="count"></span>
  </div>

  <div class="panel table-wrap">
    <table class="tracks">
      <thead>
        <tr>
          <th>Titel</th>
          <th>Interpret</th>
          <th class="hide-sm">Album</th>
          <th class="num">Dauer</th>
          <th>Plattformen</th>
          <th><span class="visually-hidden">Aktionen</span></th>
        </tr>
      </thead>
      <tbody id="tracks">
        <tr><td colspan="6" class="empty">Lade …</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Track hinzufügen</h2>
  <form class="panel add" id="add-form" autocomplete="off">
    <input name="title" placeholder="Titel" required maxlength="500" aria-label="Titel" />
    <input name="artist" placeholder="Interpret" required maxlength="500" aria-label="Interpret" />
    <input name="album" placeholder="Album (optional)" maxlength="500" aria-label="Album" />
    <input name="duration" placeholder="Dauer m:ss" aria-label="Dauer" />
    <input name="isrc" placeholder="ISRC (optional)" aria-label="ISRC" />
    <button type="submit">Hinzufügen</button>
    <p class="feedback" id="add-feedback" role="status"></p>
  </form>
</Base>

<script>
  import { ApiError, formatDuration, parseDuration } from "../lib/api";
  import { createSession } from "../lib/session";
  import type { Track } from "../lib/types";

  const { api, tokens } = createSession();
  const tbody = document.getElementById("tracks") as HTMLTableSectionElement;
  const count = document.getElementById("count") as HTMLElement;
  const search = document.getElementById("search") as HTMLInputElement;
  const form = document.getElementById("add-form") as HTMLFormElement;
  const feedback = document.getElementById("add-feedback") as HTMLElement;

  function message(text: string) {
    tbody.replaceChildren();
    const row = tbody.insertRow();
    const cell = row.insertCell();
    cell.colSpan = 6;
    cell.className = "empty";
    cell.textContent = text;
  }

  function cell(row: HTMLTableRowElement, text: string, className = "") {
    const td = row.insertCell();
    td.textContent = text;
    if (className) td.className = className;
    return td;
  }

  function render(tracks: Track[]) {
    if (!tracks.length) return message("Noch keine Tracks.");
    tbody.replaceChildren();
    for (const t of tracks) {
      const row = tbody.insertRow();
      cell(row, t.title, "title");
      cell(row, t.artist);
      cell(row, t.album ?? "–", "hide-sm muted");
      cell(row, formatDuration(t.duration_ms), "num mono");
      const linked = t.links.filter((l) => l.status === "linked").map((l) => l.platform);
      cell(row, linked.length ? linked.join(", ") : "nur lokal", linked.length ? "" : "muted");
      const actions = row.insertCell();
      actions.className = "actions";
      const del = document.createElement("button");
      del.className = "ghost small";
      del.textContent = "Löschen";
      del.addEventListener("click", async () => {
        if (!confirm(`„${t.title}“ löschen?`)) return;
        try {
          await api.deleteTrack(t.id);
          load();
        } catch (e) {
          alert(e instanceof ApiError ? e.message : "Löschen fehlgeschlagen.");
        }
      });
      actions.append(del);
    }
  }

  let timer: number | undefined;
  async function load() {
    if (!tokens.getToken()) return message("Bitte zuerst auf der Übersicht anmelden.");
    try {
      const q = search.value.trim();
      const page = await api.listTracks(q ? { q, limit: 200 } : { limit: 200 });
      count.textContent = `${page.total} ${page.total === 1 ? "Track" : "Tracks"}`;
      render(page.items);
    } catch (e) {
      message(e instanceof ApiError ? e.message : "API nicht erreichbar.");
    }
  }

  search.addEventListener("input", () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(load, 250);
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const text = (name: string) => String(data.get(name) ?? "").trim();
    try {
      await api.createTrack({
        title: text("title"),
        artist: text("artist"),
        album: text("album") || null,
        duration_ms: parseDuration(text("duration")),
        isrc: text("isrc") || null,
      });
      form.reset();
      feedback.textContent = "Gespeichert.";
      feedback.classList.remove("error-text");
      load();
    } catch (e) {
      const detail =
        e instanceof ApiError && e.problem?.errors?.length
          ? e.problem.errors.map((err) => `${err.loc.at(-1)}: ${err.msg}`).join(" · ")
          : e instanceof Error
            ? e.message
            : "Speichern fehlgeschlagen.";
      feedback.textContent = detail;
      feedback.classList.add("error-text");
    }
  });

  load();
</script>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0 12px;
  }
  .toolbar input {
    flex: 1;
    max-width: 420px;
  }
  .count {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .table-wrap {
    padding: 0;
    overflow-x: auto;
  }
  /* Zeilen entstehen per Skript und tragen kein Scope-Attribut, daher global unter .tracks */
  :global(table.tracks) {
    width: 100%;
    border-collapse: collapse;
  }
  :global(.tracks th),
  :global(.tracks td) {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
    white-space: nowrap;
  }
  :global(.tracks th) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-weight: 600;
  }
  :global(.tracks tbody tr:last-child td) {
    border-bottom: 0;
  }
  :global(.tracks td.title) {
    font-weight: 600;
    white-space: normal;
  }
  :global(.tracks td.muted),
  :global(.tracks td.empty) {
    color: var(--muted);
  }
  :global(.tracks td.empty) {
    text-align: center;
    padding: 28px;
    white-space: normal;
  }
  :global(.tracks .num) {
    text-align: right;
  }
  :global(.tracks td.actions) {
    text-align: right;
    width: 1%;
  }
  :global(.tracks button.small) {
    padding: 4px 10px;
    font-size: 0.82rem;
  }
  .add {
    display: grid;
    grid-template-columns: 2fr 2fr 2fr 1fr 1.4fr auto;
    gap: 8px;
  }
  .add .feedback {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    min-height: 1.5em;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 720px) {
    .add {
      grid-template-columns: 1fr 1fr;
    }
    :global(.tracks .hide-sm) {
      display: none;
    }
  }
</style>
